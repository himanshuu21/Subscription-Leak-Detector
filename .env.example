# Copy this to .env and fill in values. Never commit .env to git.

# --- Database ---
# SQLite for local dev (no Docker needed for unit tests):
DATABASE_URL=sqlite:///./dev.db
# Postgres when running via docker-compose or on Render/Railway:
# DATABASE_URL=postgresql://user:password@localhost:5432/subscriptions_db

# --- Auth ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- App ---
# Currency symbol displayed in the UI (cosmetic only — one currency per upload)
CURRENCY_SYMBOL=₹
MAX_UPLOAD_BYTES=5242880
ANALYSIS_ASYNC_THRESHOLD_ROWS=2000
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
MIN_PASSWORD_LENGTH=12

# --- Google OpenID Connect (optional) ---
# Create a Web application OAuth client in Google Cloud Console.
# Local redirect URI: http://127.0.0.1:8000/api/auth/google/callback
# If you browse via localhost, also register http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker Compose only (do not commit real values)
POSTGRES_USER=sld_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=subscriptions_db
